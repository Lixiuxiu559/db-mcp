# Compose settings. Set UID/GID to the owner of ./runtime.
COMPOSE_PROJECT_NAME=db-mcp
DOCKER_UID=1000
DOCKER_GID=1000
DBMCP_IMAGE=lijx559/db-mcp:2.1.0
DBMCP_BIND_ADDRESS=127.0.0.1
DBMCP_PORT=8807
TZ=Asia/Shanghai

# Optional resource credentials, referenced by ${VARIABLE} in runtime/config.yaml.
# Web passwords and MCP tokens are managed in the web console.
# DBMCP_PG_MAIN_PASSWORD=replace-me
# DBMCP_PG_OPS_PASSWORD=replace-me
# DBMCP_REDIS_PASSWORD=replace-me
